{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://faros.sh/schemas/telemetry/metric/v1.json",
  "title": "Faros telemetry metric definition",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "key_path", "description", "owner", "product_group", "product_categories", "value_type", "metric_kind", "status", "time_frame", "data_source", "events", "labels"],
  "properties": {
    "version": {"type": "integer", "const": 1},
    "key_path": {"type": "string", "pattern": "^[a-z][a-z0-9_]*(?:\\.[a-z][a-z0-9_]*)*$", "maxLength": 160},
    "description": {"type": "string", "minLength": 1},
    "owner": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$"},
    "product_group": {"type": "string", "minLength": 1},
    "product_categories": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "value_type": {"const": "number"},
    "metric_kind": {"enum": ["counter", "funnel"]},
    "status": {"enum": ["active", "removed"]},
    "time_frame": {"enum": ["all", "7d", "28d"]},
    "data_source": {"const": "internal_events"},
    "introduced_by_url": {"type": "string", "format": "uri"},
    "removed_by_url": {"type": "string", "format": "uri"},
    "milestone_removed": {"type": "string"},
    "events": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name"],
        "properties": {
          "name": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$"},
          "unique": {"enum": ["org", "workspace", "project", "actor", "resource"]},
          "filter": {"type": "object", "additionalProperties": {"type": "string"}}
        }
      }
    },
    "labels": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["description", "values"],
        "properties": {
          "description": {"type": "string", "minLength": 1},
          "values": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
        }
      }
    }
  }
}
