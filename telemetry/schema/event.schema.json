{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://faros.sh/schemas/telemetry/event/v1.json",
  "title": "Faros telemetry event definition",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "internal_events", "action", "description", "owner", "product_group", "product_categories", "identifiers", "tiers", "milestone", "status", "introduced_by_url", "retention_days", "privacy", "additional_properties"],
  "properties": {
    "version": {"type": "integer", "const": 1},
    "internal_events": {"type": "boolean", "const": true},
    "action": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$", "maxLength": 128},
    "description": {"type": "string", "minLength": 1, "maxLength": 512},
    "owner": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$"},
    "product_group": {"type": "string", "minLength": 1},
    "product_categories": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "identifiers": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["org", "workspace", "scope", "project", "actor", "resource", "run"]}},
    "tiers": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["free", "premium", "ultimate"]}},
    "milestone": {"type": "string", "minLength": 1},
    "status": {"enum": ["active", "removed"]},
    "introduced_by_url": {"type": "string", "format": "uri"},
    "removed_by_url": {"type": "string", "format": "uri"},
    "milestone_removed": {"type": "string"},
    "retention_days": {"type": "integer", "minimum": 1, "maximum": 90},
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["class", "no_raw_content"],
      "properties": {
        "class": {"enum": ["pseudonymous"]},
        "pseudonymize": {"type": "array", "uniqueItems": true, "items": {"enum": ["org", "workspace", "scope", "project", "actor", "resource", "run"]}},
        "no_raw_content": {"type": "boolean", "const": true}
      }
    },
    "additional_properties": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["description", "type"],
        "properties": {
          "description": {"type": "string", "minLength": 1},
          "type": {"enum": ["boolean", "number", "string"]},
          "enum": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$", "maxLength": 64}},
          "minimum": {"type": "number"},
          "maximum": {"type": "number"}
        }
      }
    }
  }
}
