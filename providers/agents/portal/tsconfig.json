{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noImplicitAny": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    // Lit's @property/@state decorators are the legacy (experimental) flavour,
    // and its generated accessors require class fields to be assigned rather
    // than defined — hence useDefineForClassFields: false.
    "experimentalDecorators": true,
    "useDefineForClassFields": false,
    "types": ["vite/client"]
  },
  "include": ["src/**/*.ts", "src/**/*.d.ts", "vite.config.ts", "vitest.config.ts"]
}
